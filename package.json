{
  "name": "lig4-frontend",
  "version": "1.0.0",
  "description": "Frontend do projeto LIG 4.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "eslint src/ && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "pinia": "^2.1.7",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-rscss": "^0.4.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
